---
import SectionHeading from "./SectionHeading.astro";
import { site } from "../content/site";
const r = site.roadmap;
---
<section id="roadmap" class="section">
  <div class="container">
    <SectionHeading number="04" label="Roadmap" title={r.heading} />
    <p class="prose muted intro" data-reveal>{r.blurb}</p>

    <ol class="timeline" data-reveal>
      {r.items.map((it) => (
        <li class:list={["item", it.state]}>
          <span class="post" aria-hidden="true"></span>
          <div class="body">
            <span class="label when">{it.when}</span>
            <h3>{it.title}</h3>
            <p class="muted">{it.detail}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .intro { margin-bottom: var(--s-8); }
  /* A fence, turned on its side: the rail runs down, each milestone is a post */
  .timeline { list-style: none; margin: 0; padding: 0; max-width: var(--prose); position: relative; }
  .timeline::before { content: ""; position: absolute; left: 0.3rem; top: 0.9rem; bottom: 1rem; width: 0.4rem; background: var(--wood-2); border-radius: 2px; }
  .item { position: relative; padding-left: 2.25rem; margin-bottom: var(--s-6); }
  .post { position: absolute; left: 0; top: 0.1rem; width: 1rem; height: 1.5rem; background: var(--wood); border-radius: 2px 2px 1px 1px; }
  .post::before { content: ""; position: absolute; left: 0; right: 0; top: -0.3rem; height: 0.3rem; background: inherit; clip-path: polygon(0 100%, 50% 0, 100% 100%); }
  .done .post { background: var(--accent); }
  .now .post { background: var(--gold); box-shadow: 0 0 0 4px var(--gold-glow); }
  .next .post, .later .post { background: var(--surface-2); box-shadow: inset 0 0 0 1.5px var(--wood); }
  .later { opacity: 0.75; }
  .body { display: grid; gap: var(--s-1); }
  .when { color: var(--accent-text); }
  .now .when { color: var(--gold); }
  h3 { font-size: 1.125rem; }
  @media (prefers-reduced-motion: no-preference) {
    .now .post { animation: lantern 2.4s var(--ease) infinite; }
    @keyframes lantern { 0%, 100% { box-shadow: 0 0 0 4px var(--gold-glow); } 50% { box-shadow: 0 0 0 9px rgba(233,196,106,0.06); } }
  }
</style>
