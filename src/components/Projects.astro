---
import SectionHeading from "./SectionHeading.astro";
import { site } from "../content/site";
const p = site.projects;
---
<section id="projects" class="section">
  <div class="lantern" aria-hidden="true">
    <svg viewBox="0 0 40 90" focusable="false"><path d="M20 0 V 22" stroke="var(--wood)" stroke-width="3" /><path d="M8 26 H 32 L 28 32 H 12 Z" fill="var(--wood-2)" /><rect x="11" y="32" width="18" height="30" rx="2" fill="var(--gold)" /><path d="M11 40 H 29 M11 54 H 29 M20 32 V 62" stroke="var(--wood-2)" stroke-width="1.5" /><path d="M12 62 H 28 L 26 70 H 14 Z" fill="var(--wood-2)" /><circle cx="20" cy="47" r="30" fill="url(#lantern-glow)" /><defs><radialGradient id="lantern-glow"><stop offset="0" stop-color="rgba(233,196,106,.45)" /><stop offset="1" stop-color="rgba(233,196,106,0)" /></radialGradient></defs></svg>
  </div>
  <div class="container">
    <SectionHeading number="02" label="Projects" title={p.heading} />
    <p class="prose muted intro" data-reveal>{p.blurb}</p>

    <div class="grid-projects" data-reveal>
      {p.items.map((it, i) => (
        <article class="card stall">
          <div class="top">
            <span class="label stall-no">Stall {String(i + 1).padStart(2, "0")}</span>
            <span class:list={["pill", { live: it.live }]}>
              <span class="dot" aria-hidden="true"></span>{it.status}
            </span>
          </div>
          <h3>{it.name}</h3>
          <p class="muted">{it.blurb}</p>
          <ul class="stack" aria-label="Built with">
            {it.stack.map((s) => <li class="label">{s}</li>)}
          </ul>
          {it.links.length > 0 && (
            <div class="links">
              {it.links.map((l) =>
                l.href ? (
                  <a class="btn btn-ghost" href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>
                ) : (
                  <span class="label soft">{l.label}</span>
                )
              )}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .lantern { position: absolute; top: 0; right: clamp(1rem, 6vw, 6rem); width: 44px; line-height: 0; }
  .lantern svg { width: 100%; overflow: visible; }
  .intro { margin-bottom: var(--s-6); }
  .grid-projects { display: grid; gap: var(--s-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr)); }
  /* Each project is a stall: a wooden header rail with a number plate and a status tag */
  .stall { display: grid; gap: var(--s-3); align-content: start; padding-top: 0; overflow: hidden; }
  .top { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); margin-inline: calc(-1 * var(--s-6)); padding: var(--s-2) var(--s-6); background: linear-gradient(180deg, var(--wood-2), var(--surface-2)); border-bottom: 2px solid var(--wood); }
  .stall-no { color: var(--gold); }
  .pill { display: inline-flex; align-items: center; gap: var(--s-2); font-family: var(--font-mono); font-size: var(--fs-label); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); border: 1px solid var(--border); border-radius: 999px; padding: 0.25rem 0.6rem; background: var(--surface); }
  .pill .dot { width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--muted); }
  .pill.live { color: var(--text); border-color: var(--accent); }
  .pill.live .dot { background: var(--accent-text); }
  h3 { font-size: 1.125rem; margin-top: var(--s-2); }
  .stack { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .stack li { border: 1px solid var(--border); border-radius: var(--radius); padding: 0.15rem 0.45rem; }
  .links { display: flex; flex-wrap: wrap; gap: var(--s-2); align-items: center; margin-top: var(--s-1); }
  @media (prefers-reduced-motion: no-preference) {
    .lantern { transform-origin: top center; animation: swing 5s ease-in-out infinite alternate; }
    @keyframes swing { from { transform: rotate(-2deg); } to { transform: rotate(2deg); } }
  }
  .soft { border: 1px dashed var(--wood); border-radius: var(--radius); padding: 0.4rem 0.6rem; text-transform: none; letter-spacing: 0; }
</style>
