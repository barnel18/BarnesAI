---
import SectionHeading from "./SectionHeading.astro";
import { site } from "../content/site";
const s = site.skills;
---
<section id="skills" class="section">
  <div class="container">
    <SectionHeading number="03" label="Skills" title={s.heading} />
    <p class="prose muted intro" data-reveal>{s.blurb}</p>

    <div class="wall" data-reveal>
      {s.groups.map((g) => (
        <div class="shelf">
          <span class="label shelf-name">{g.name}</span>
          <ul class="tools" aria-label={g.name}>
            {g.items.map((t) => <li>{t}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .intro { margin-bottom: var(--s-6); }
  /* A pegboard tool wall: each group is a shelf, each skill a tool hanging on it */
  .wall {
    display: grid; gap: var(--s-6); padding: var(--s-6);
    background:
      radial-gradient(circle at 1.5px 1.5px, rgba(0,0,0,.55) 1.5px, transparent 2px) 0 0 / 22px 22px,
      #241C17;
    border: 2px solid var(--wood-2); border-radius: var(--radius);
    box-shadow: inset 0 0 0 1px rgba(255,244,232,.04), 0 10px 30px rgba(0,0,0,.35);
  }
  .shelf { display: grid; gap: var(--s-3); padding-bottom: var(--s-4); border-bottom: 6px solid var(--wood); }
  .shelf:last-child { border-bottom: 0; padding-bottom: 0; }
  .shelf-name { color: var(--gold); }
  .tools { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .tools li {
    position: relative; padding: 0.35rem 0.7rem 0.35rem 1.1rem; font-size: var(--fs-sm);
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text);
  }
  .tools li::before { content: ""; position: absolute; left: 0.45rem; top: 50%; width: 5px; height: 5px; border-radius: 50%; background: var(--muted); transform: translateY(-50%); box-shadow: inset 0 1px 1px rgba(0,0,0,.6); }
</style>
