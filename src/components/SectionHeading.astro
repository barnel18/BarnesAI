---
interface Props { number: string; label: string; title: string }
const { number, label, title } = Astro.props;
---
<div class="heading" data-reveal>
  <span class="label tag"><span class="num">{number}</span> / {label}</span>
  <h2>{title}</h2>
</div>

<style>
  .heading { display: grid; gap: var(--s-4); margin-bottom: var(--s-8); justify-items: start; }
  .tag {
    display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.4rem 0.8rem 0.35rem 0.7rem;
    background: linear-gradient(180deg, var(--wood), var(--wood-2)); color: var(--text); border-radius: 2px;
    box-shadow: inset 0 1px 0 rgba(255,244,232,.14), 0 2px 0 rgba(0,0,0,.45); transform: rotate(-1.2deg);
  }
  .tag::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--gold); box-shadow: inset 0 1px 1px rgba(0,0,0,.6); }
  .num { color: var(--gold); }
</style>
