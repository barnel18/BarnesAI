---
interface Props { number: string; label: string; title: string }
const { number, label, title } = Astro.props;
---
<div class="heading" data-reveal>
  <span class="label"><span class="num">{number}</span> / {label}</span>
  <h2>{title}</h2>
</div>

<style>
  .heading { display: grid; gap: var(--s-3); margin-bottom: var(--s-8); }
  .num { color: var(--accent); }
</style>
