---
import Grass from "./Grass.astro";
// Hero illustration. Doors slide open, windows light up, the vane turns, the moon drifts — all from --sy.
// With reduced motion (or no JS) the doors are simply open and lit.
---
<div class="scene" aria-hidden="true">
  <svg class="barn" viewBox="0 0 440 300" focusable="false">

    <!-- ground -->
    <path d="M0 272 H 440" stroke="var(--border)" stroke-width="3" />

    <!-- silo -->
    <rect x="352" y="118" width="54" height="154" fill="var(--wood-2)" />
    <path d="M352 118 A 27 27 0 0 1 406 118 Z" fill="var(--wood)" />
    <g fill="rgba(0,0,0,0.28)">
      <rect x="352" y="150" width="54" height="3" /><rect x="352" y="190" width="54" height="3" /><rect x="352" y="230" width="54" height="3" />
    </g>

    <!-- walls + roof -->
    <rect x="70" y="126" width="250" height="146" fill="var(--accent)" />
    <path d="M56 132 L 108 72 L 195 44 L 282 72 L 334 132 Z" fill="var(--accent-deep)" />
    <path d="M56 132 L 108 72 L 195 44 L 282 72 L 334 132" fill="none" stroke="var(--wood-2)" stroke-width="3" stroke-linejoin="round" />

    <!-- hayloft door -->
    <path d="M180 122 V 100 A 15 15 0 0 1 210 100 V 122 Z" fill="var(--bg)" />
    <path d="M180 122 V 100 A 15 15 0 0 1 210 100 V 122" fill="none" stroke="var(--wood-2)" stroke-width="2" />

    <!-- side windows (light up with the doors) -->
    <rect x="92" y="196" width="24" height="24" fill="var(--bg)" />
    <rect x="274" y="196" width="24" height="24" fill="var(--bg)" />
    <rect class="win" x="92" y="196" width="24" height="24" fill="var(--gold)" />
    <rect class="win" x="274" y="196" width="24" height="24" fill="var(--gold)" />
    <path d="M104 196 V 220 M92 208 H 116 M286 196 V 220 M274 208 H 298" stroke="var(--accent-deep)" stroke-width="2" />

    <!-- doorway: the lit interior -->
    <rect x="140" y="176" width="110" height="96" fill="var(--gold)" />
    <rect x="140" y="176" width="110" height="96" fill="url(#barn-inner)" />
    <defs>
      <linearGradient id="barn-inner" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="rgba(122,31,20,0.55)" />
        <stop offset="1" stop-color="rgba(122,31,20,0)" />
      </linearGradient>
    </defs>

    <!-- door rail + sliding doors -->
    <rect x="96" y="168" width="198" height="6" fill="var(--wood-2)" />
    <g class="door door-l">
      <rect x="141" y="174" width="54" height="98" fill="var(--accent-deep)" stroke="var(--wood)" stroke-width="3" />
      <path d="M141 174 L 195 272 M195 174 L 141 272" stroke="#C9A06A" stroke-width="3" />
      <rect x="141" y="174" width="54" height="98" fill="none" stroke="#C9A06A" stroke-width="3" />
    </g>
    <g class="door door-r">
      <rect x="195" y="174" width="54" height="98" fill="var(--accent-deep)" stroke="var(--wood)" stroke-width="3" />
      <path d="M195 174 L 249 272 M249 174 L 195 272" stroke="#C9A06A" stroke-width="3" />
      <rect x="195" y="174" width="54" height="98" fill="none" stroke="#C9A06A" stroke-width="3" />
    </g>

    <!-- weathervane -->
    <path d="M195 44 V 14" stroke="var(--muted)" stroke-width="3" stroke-linecap="round" />
    <g class="vane">
      <path d="M172 20 H 216" stroke="var(--muted)" stroke-width="3" stroke-linecap="round" />
      <path d="M216 20 L 208 14 M216 20 L 208 26" stroke="var(--muted)" stroke-width="3" stroke-linecap="round" />
      <path d="M172 20 L 178 14 V 26 Z" fill="var(--muted)" />
    </g>
    <circle cx="195" cy="20" r="3" fill="var(--gold)" />

    <!-- a dog waiting by the door -->
    <g class="pup" fill="var(--muted)">
      <path d="M26 272 C 26 252 32 240 44 240 C 54 240 58 250 58 272 Z" />
      <circle cx="36" cy="238" r="8" />
      <path d="M30 236 L 20 241 L 31 245 Z" />
      <path d="M40 231 L 44 221 L 47 232 Z" />
      <path d="M58 268 C 66 262 70 254 74 248" fill="none" stroke="var(--muted)" stroke-width="4" stroke-linecap="round" />
    </g>
  </svg>
  <div class="turf"><Grass id="barn" height={20} /></div>
</div>

<style>
  /* --open: 0 = doors shut, 1 = doors open. Driven by page scroll (--sy, in viewport heights):
     shut at the top of the page, fully open about 0.4 screens down, while the barn is still in view. */
  .scene { position: relative; --open: 1; }
  .scene::after {
    content: ""; position: absolute; left: 22%; right: 22%; top: 50%; bottom: -10%;
    background: radial-gradient(closest-side, var(--gold-glow), transparent 75%);
    opacity: var(--open); pointer-events: none; z-index: -1;
  }
  .barn { width: 100%; height: auto; overflow: visible; }
  .door, .vane, .win { transform-box: view-box; }
  .door-l { transform: translateX(calc(var(--open) * -56px)); }
  .door-r { transform: translateX(calc(var(--open) * 56px)); }
  .win { opacity: var(--open); }
  .vane { transform-origin: 195px 20px; }
  .turf { position: absolute; left: 4%; right: 4%; bottom: 9.3%; line-height: 0; }

  @media (prefers-reduced-motion: no-preference) {
    .scene { --open: min(calc(var(--sy, 0) * 2.4), 1); }
    .vane { transform: rotate(calc(var(--sy, 0) * 220deg)); }
  }
</style>
