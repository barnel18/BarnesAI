---
// Geometric farm silhouettes, all facing left, fill = currentColor.
interface Props { kind: "dog" | "cow" | "chicken" | "pig" }
const { kind } = Astro.props;
---
{kind === "cow" && (
  <svg viewBox="0 0 120 80" fill="currentColor" aria-hidden="true" focusable="false">
    <rect x="26" y="24" width="74" height="36" rx="16" />
    <path d="M34 30 C 26 20, 8 22, 6 36 L 6 46 C 6 53, 13 55, 20 53 L 34 49 Z" />
    <path d="M10 27 L 2 20 L 14 23 Z" />
    <path d="M22 24 L 26 12 L 30 24 Z" />
    <rect x="32" y="52" width="9" height="26" rx="3" />
    <rect x="45" y="54" width="9" height="24" rx="3" />
    <rect x="76" y="54" width="9" height="24" rx="3" />
    <rect x="89" y="52" width="9" height="26" rx="3" />
    <path d="M97 32 C 108 30, 113 42, 109 58 L 104 57 C 107 46, 104 38, 96 38 Z" />
    <ellipse cx="72" cy="60" rx="9" ry="4" />
  </svg>
)}
{kind === "dog" && (
  <svg viewBox="0 0 120 70" fill="currentColor" aria-hidden="true" focusable="false">
    <ellipse cx="62" cy="38" rx="34" ry="13" />
    <circle cx="24" cy="30" r="12" />
    <path d="M14 30 L 0 36 L 14 40 Z" />
    <path d="M27 20 L 34 6 L 38 21 Z" />
    <path d="M92 32 C 100 26, 106 18, 112 8 L 117 11 C 111 22, 105 32, 96 40 Z" />
    <path d="M38 46 L 18 64 L 24 68 L 44 52 Z" />
    <path d="M50 48 L 44 68 L 50 69 L 58 50 Z" />
    <path d="M74 46 L 94 62 L 90 67 L 68 52 Z" />
    <path d="M84 44 L 104 54 L 101 59 L 80 50 Z" />
  </svg>
)}
{kind === "chicken" && (
  <svg viewBox="0 0 64 64" fill="currentColor" aria-hidden="true" focusable="false">
    <ellipse cx="32" cy="38" rx="18" ry="12" />
    <path d="M46 34 L 60 18 L 56 32 L 63 28 L 54 42 Z" />
    <circle cx="15" cy="24" r="7.5" />
    <path d="M8 23 L 0 26 L 8 29 Z" />
    <path d="M11 17.5 L 12 11 L 15 16 L 18 10 L 19 17 Z" />
    <path d="M14 31 L 12 36 L 17 33 Z" />
    <rect x="26" y="48" width="2.6" height="10" />
    <rect x="35" y="48" width="2.6" height="10" />
    <path d="M22 58 H 33 M31 58 H 42" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
  </svg>
)}
{kind === "pig" && (
  <svg viewBox="0 0 100 62" fill="currentColor" aria-hidden="true" focusable="false">
    <rect x="18" y="12" width="66" height="36" rx="18" />
    <path d="M24 20 C 12 18, 4 26, 4 36 C 4 44, 10 48, 18 46 L 26 42 Z" />
    <rect x="1" y="30" width="9" height="9" rx="2.5" />
    <path d="M28 16 L 26 4 L 38 12 Z" />
    <rect x="26" y="44" width="9" height="15" rx="2" />
    <rect x="40" y="44" width="9" height="15" rx="2" />
    <rect x="62" y="44" width="9" height="15" rx="2" />
    <rect x="74" y="44" width="9" height="15" rx="2" />
    <path d="M83 22 C 90 14, 96 20, 91 25 C 88 28, 84 25, 87 22" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
  </svg>
)}
