---
// Farm silhouettes, all facing left, fill = currentColor. Legs are separate strokes so they can
// swing from the hip as the parent's --p (scroll progress) changes — they walk while you scroll.
interface Props { kind: "dog" | "cow" | "rooster" | "pig" | "sheep" }
const { kind } = Astro.props;
---
{kind === "dog" && (
  <svg viewBox="0 0 200 110" fill="currentColor" aria-hidden="true" focusable="false">
    <path d="M8 46 C14 40 22 36 32 34 C36 26 46 22 54 26 C60 28 64 32 66 34 C78 30 88 28 98 30 C116 30 136 30 154 36 C162 40 166 50 164 62 C158 70 140 70 126 68 C108 70 96 72 84 70 C74 68 66 62 60 56 C56 54 50 55 44 55 C34 56 22 56 14 54 C9 52 6 49 8 46 Z" />
    <path d="M54 26 C60 32 62 42 58 50 C54 52 50 46 50 38 C50 32 52 28 54 26 Z" />
    <g class="limbs">
      <path class="tail" style="transform-origin: 158px 40px" d="M158 40 C172 32 184 22 190 8" stroke-width="7" />
      <path class="leg" style="--dir: 1; transform-origin: 74px 62px" d="M74 62 C66 72 56 82 36 88" stroke-width="9" />
      <path class="leg" style="--dir: -1; transform-origin: 84px 64px" d="M84 64 C82 76 78 88 70 98" stroke-width="9" />
      <path class="leg" style="--dir: -1; transform-origin: 150px 60px" d="M150 60 C160 72 172 84 190 92" stroke-width="9" />
      <path class="leg" style="--dir: 1; transform-origin: 140px 62px" d="M140 62 C146 76 148 90 146 102" stroke-width="9" />
    </g>
  </svg>
)}
{kind === "cow" && (
  <svg viewBox="0 0 240 140" fill="currentColor" aria-hidden="true" focusable="false">
    <path d="M56 40 C80 30 150 28 190 36 C208 40 214 56 212 78 C210 92 200 100 186 102 L70 102 C56 100 48 88 50 72 C52 58 52 48 56 40 Z" />
    <path d="M62 40 C50 38 42 40 38 46 C30 54 22 62 16 72 C14 78 16 86 24 88 C34 90 44 88 50 82 C56 76 60 66 64 56 Z" />
    <path d="M52 44 L68 36 L64 50 Z" />
    <ellipse cx="160" cy="104" rx="16" ry="8" />
    <circle cx="218" cy="98" r="5" />
    <g class="limbs">
      <path d="M46 42 C42 34 44 26 52 26" stroke-width="4" />
      <path class="tail" style="transform-origin: 210px 46px" d="M210 46 C222 56 224 76 218 96" stroke-width="5" />
      <path class="leg" style="--dir: 1; transform-origin: 78px 100px" d="M78 100 L78 134" stroke-width="11" />
      <path class="leg" style="--dir: -1; transform-origin: 96px 100px" d="M96 100 L96 134" stroke-width="11" />
      <path class="leg" style="--dir: -1; transform-origin: 176px 100px" d="M176 100 L176 134" stroke-width="11" />
      <path class="leg" style="--dir: 1; transform-origin: 194px 100px" d="M194 100 L194 134" stroke-width="11" />
    </g>
  </svg>
)}
{kind === "rooster" && (
  <svg viewBox="0 0 130 140" fill="currentColor" aria-hidden="true" focusable="false">
    <path d="M30 84 C30 62 52 52 74 56 C92 60 100 74 96 90 C92 106 72 112 52 108 C38 104 30 96 30 84 Z" />
    <path d="M46 70 C40 56 36 42 30 34 C26 26 28 18 36 16 C44 14 50 20 48 30 C46 42 54 56 62 66 Z" />
    <path d="M30 18 C28 10 32 6 36 10 C38 4 44 4 44 12 C48 8 52 12 48 18 Z" />
    <path d="M26 24 L12 28 L26 32 Z" />
    <path d="M32 34 C30 40 34 44 38 40 Z" />
    <g class="limbs">
      <path d="M92 76 C104 60 116 42 118 20" stroke-width="8" />
      <path d="M94 82 C110 72 124 56 128 40" stroke-width="8" />
      <path d="M92 90 C108 88 120 78 128 64" stroke-width="8" />
      <path class="leg" style="--dir: 1; transform-origin: 60px 108px" d="M60 108 L58 128 M48 128 H68" stroke-width="3" />
      <path class="leg" style="--dir: -1; transform-origin: 74px 106px" d="M74 106 L76 128 M68 128 H86" stroke-width="3" />
    </g>
  </svg>
)}
{kind === "pig" && (
  <svg viewBox="0 0 200 120" fill="currentColor" aria-hidden="true" focusable="false">
    <path d="M60 34 C90 24 150 24 174 36 C190 44 194 66 186 82 C178 96 150 100 120 100 L70 100 C52 98 42 84 42 66 C42 50 48 40 60 34 Z" />
    <path d="M60 40 C42 36 26 44 18 58 C14 66 16 76 22 82 C30 90 44 90 54 84 Z" />
    <rect x="8" y="62" width="14" height="14" rx="5" />
    <path d="M58 38 C56 28 60 20 70 22 C72 30 68 38 64 42 Z" />
    <g class="limbs">
      <path d="M186 52 C196 44 200 54 192 58 C188 60 188 54 192 52" stroke-width="4" />
      <path class="leg" style="--dir: 1; transform-origin: 76px 98px" d="M76 98 L76 116" stroke-width="12" />
      <path class="leg" style="--dir: -1; transform-origin: 96px 98px" d="M96 98 L96 116" stroke-width="12" />
      <path class="leg" style="--dir: -1; transform-origin: 146px 98px" d="M146 98 L146 116" stroke-width="12" />
      <path class="leg" style="--dir: 1; transform-origin: 166px 98px" d="M166 98 L166 116" stroke-width="12" />
    </g>
  </svg>
)}
{kind === "sheep" && (
  <svg viewBox="0 0 180 120" fill="currentColor" aria-hidden="true" focusable="false">
    <circle cx="66" cy="62" r="22" /><circle cx="92" cy="52" r="28" /><circle cx="120" cy="58" r="26" /><circle cx="142" cy="68" r="20" /><circle cx="82" cy="76" r="22" /><circle cx="112" cy="80" r="22" />
    <path d="M46 50 C32 46 20 54 20 66 C20 76 28 82 38 80 C48 78 52 68 50 58 Z" />
    <path d="M36 52 L22 46 L30 58 Z" />
    <g class="limbs">
      <path class="leg" style="--dir: 1; transform-origin: 72px 94px" d="M72 94 L72 114" stroke-width="6" />
      <path class="leg" style="--dir: -1; transform-origin: 88px 96px" d="M88 96 L88 114" stroke-width="6" />
      <path class="leg" style="--dir: -1; transform-origin: 118px 96px" d="M118 96 L118 114" stroke-width="6" />
      <path class="leg" style="--dir: 1; transform-origin: 134px 92px" d="M134 92 L134 114" stroke-width="6" />
    </g>
  </svg>
)}

<style>
  .limbs path { fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; }
  .leg, .tail { transform-box: view-box; }
  @media (prefers-reduced-motion: no-preference) {
    /* --p is the parent strip's scroll progress; the legs swing as it changes, so they walk only while you scroll */
    .leg { transform: rotate(calc(sin(var(--p, 0.5) * 40) * var(--dir, 1) * 13deg)); }
    .tail { transform: rotate(calc(sin(var(--p, 0.5) * 24) * 7deg)); }
  }
</style>
