---
// A farmhouse at night: porch light on, two windows lit.
---
<svg class="house" viewBox="0 0 280 200" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="porch-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="rgba(233,196,106,.55)" /><stop offset="1" stop-color="rgba(233,196,106,0)" />
    </radialGradient>
  </defs>
  <rect x="60" y="86" width="150" height="100" fill="var(--wood-2)" />
  <path d="M48 90 L 135 28 L 222 90 Z" fill="var(--accent-deep)" />
  <path d="M48 90 L 135 28 L 222 90" fill="none" stroke="var(--wood)" stroke-width="4" stroke-linejoin="round" />
  <rect x="176" y="42" width="16" height="34" fill="var(--wood)" />
  <rect x="40" y="118" width="190" height="8" fill="var(--wood)" />
  <rect x="48" y="126" width="6" height="60" fill="var(--wood)" /><rect x="216" y="126" width="6" height="60" fill="var(--wood)" />
  <rect x="40" y="184" width="190" height="6" fill="var(--wood)" />
  <rect x="122" y="134" width="28" height="52" fill="var(--bg)" />
  <circle cx="145" cy="160" r="2" fill="var(--gold)" />
  <rect x="78" y="136" width="26" height="26" fill="var(--gold)" /><path d="M91 136 V 162 M78 149 H 104" stroke="var(--wood-2)" stroke-width="2" />
  <rect x="168" y="136" width="26" height="26" fill="var(--gold)" /><path d="M181 136 V 162 M168 149 H 194" stroke="var(--wood-2)" stroke-width="2" />
  <rect x="126" y="92" width="20" height="18" fill="var(--bg)" />
  <circle class="glow" cx="136" cy="128" r="30" fill="url(#porch-glow)" />
  <circle cx="136" cy="128" r="3.5" fill="var(--gold)" />
  <path d="M0 190 H 280" stroke="var(--grass)" stroke-width="3" />
</svg>

<style>
  .house { width: 100%; max-width: 17rem; height: auto; }
  @media (prefers-reduced-motion: no-preference) {
    .glow { animation: flicker 4s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
    @keyframes flicker { 0%, 100% { opacity: 1; } 47% { opacity: .85; } 52% { opacity: 1; } 80% { opacity: .9; } }
  }
</style>
