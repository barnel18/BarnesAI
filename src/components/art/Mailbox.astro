  <circle cx="27" cy="92" r="3.5" fill="var(--gold)" />
  <rect x="134" y="18" width="5" height="46" fill="var(--muted)" />
  <path d="M139 18 H 166 L 158 30 L 166 42 H 139 Z" fill="var(--accent)" />
