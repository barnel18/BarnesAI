  <path d="M18 116 V 66 C 18 50 30 40 46 40 H 128 C 144 40 152 52 152 66 V 116 Z" fill="var(--accent-deep)" />
  <path d="M18 116 V 66 C 18 50 30 40 46 40 H 60 C 44 40 34 50 34 66 V 116 Z" fill="var(--accent)" />
