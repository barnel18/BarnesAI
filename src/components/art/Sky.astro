---
// The night sky behind the whole page: fixed gradient, three star layers with a slow twinkle,
// a handful of bright stars that twinkle on their own, a moon that crosses the sky as you scroll
// the page, and the occasional meteor. Star positions are seeded so every build is identical.
function rng(seed: number) {
  return () => { seed |= 0; seed = (seed + 0x6d2b79f5) | 0; let t = Math.imul(seed ^ (seed >>> 15), 1 | seed); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
}
const layer = (seed: number, n: number, rMin: number, rMax: number) => {
  const r = rng(seed);
  return Array.from({ length: n }, () => ({ x: +(r() * 1000).toFixed(1), y: +(r() * 1000).toFixed(1), r: +(rMin + r() * (rMax - rMin)).toFixed(2), d: +(r() * 6).toFixed(2), t: +(3 + r() * 4).toFixed(2) }));
};
const far = layer(11, 110, 0.5, 1.0);
const mid = layer(23, 60, 0.9, 1.5);
const near = layer(37, 16, 1.6, 2.4);
---
<div class="sky" aria-hidden="true">
  <svg class="stars far" viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice" focusable="false">
    {far.map((s) => <circle cx={s.x} cy={s.y} r={s.r} />)}
  </svg>
  <svg class="stars mid" viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice" focusable="false">
    {mid.map((s) => <circle cx={s.x} cy={s.y} r={s.r} />)}
  </svg>
  <svg class="stars near" viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice" focusable="false">
    {near.map((s) => <circle cx={s.x} cy={s.y} r={s.r} style={`--d:${s.d}s; --t:${s.t}s`} />)}
  </svg>
  <div class="moon"></div>
  <div class="meteor m1"></div>
  <div class="meteor m2"></div>
</div>

<style>
  .sky {
    position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none;
    background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 50%, var(--bg) 100%);
  }
  .stars { position: absolute; inset: -12% 0 0 0; width: 100%; height: 112%; fill: var(--text); }
  .far { opacity: 0.45; }
  .mid { opacity: 0.7; }
  .near { opacity: 0.95; }
  .moon {
    position: absolute; top: 8vh; right: 9vw; width: clamp(40px, 5vw, 72px); aspect-ratio: 1; border-radius: 50%;
    background: var(--gold); opacity: 0.92;
    box-shadow: 0 0 0 1px rgba(233,196,106,.25), 0 0 48px 14px rgba(233,196,106,.16);
  }
  .meteor { position: absolute; width: 160px; height: 2px; opacity: 0; border-radius: 2px;
    background: linear-gradient(90deg, rgba(242,235,223,0), rgba(242,235,223,.85)); }
  .m1 { top: 16vh; left: 58vw; }
  .m2 { top: 30vh; left: 22vw; }
  @media (max-width: 640px) { .moon { top: 6.5vh; right: 4vw; } }

  @media (prefers-reduced-motion: no-preference) {
    /* The sky drifts a little as you go, the moon crosses and sets by the footer */
    .far  { transform: translateY(calc(var(--sy, 0) * -1.5vh)); }
    .mid  { transform: translateY(calc(var(--sy, 0) * -3vh)); }
    .near { transform: translateY(calc(var(--sy, 0) * -5vh)); }
    /* keeps to the right edge, sinks slowly, and sets behind the footer horizon */
    .moon { transform: translate(calc(var(--sy, 0) * -1.2vw), calc(var(--sy, 0) * 7.5vh)); }
    .far  { animation: twinkle 7s ease-in-out infinite; }
    .mid  { animation: twinkle 5s ease-in-out infinite reverse; }
    .near circle { animation: sparkle var(--t, 4s) ease-in-out var(--d, 0s) infinite; }
    .meteor { animation: meteor 11s linear infinite; }
    .m2 { animation-duration: 17s; animation-delay: 6s; }
    @keyframes twinkle { 0%, 100% { opacity: 0.45; } 50% { opacity: 0.7; } }
    @keyframes sparkle { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }
    @keyframes meteor {
      0%, 91% { transform: rotate(-28deg) translateX(0); opacity: 0; }
      93% { opacity: 1; }
      100% { transform: rotate(-28deg) translateX(-42vw); opacity: 0; }
    }
  }
</style>
