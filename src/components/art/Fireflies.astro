---
// A few gold specks that drift and blink. Positions are percentages of the parent.
interface Props { count?: number; seed?: number }
const { count = 7, seed = 5 } = Astro.props;
let s = seed;
const r = () => { s = (s * 16807) % 2147483647; return s / 2147483647; };
const flies = Array.from({ length: count }, () => ({ x: (8 + r() * 84).toFixed(1), y: (20 + r() * 70).toFixed(1), d: (r() * 8).toFixed(1), t: (6 + r() * 6).toFixed(1), b: (2 + r() * 3).toFixed(1) }));
---
<div class="flies" aria-hidden="true">
  {flies.map((f) => <span style={`--x:${f.x}%; --y:${f.y}%; --d:${f.d}s; --t:${f.t}s; --b:${f.b}s`}></span>)}
</div>

<style>
  .flies { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .flies span {
    position: absolute; left: var(--x); top: var(--y); width: 4px; height: 4px; border-radius: 50%;
    background: var(--gold); box-shadow: 0 0 8px 2px rgba(233,196,106,.45); opacity: 0.7;
  }
  @media (prefers-reduced-motion: no-preference) {
    .flies span { animation: drift var(--t) ease-in-out var(--d) infinite alternate, blink var(--b) ease-in-out var(--d) infinite; }
    @keyframes drift { 0% { transform: translate(0, 0); } 33% { transform: translate(18px, -14px); } 66% { transform: translate(-10px, -26px); } 100% { transform: translate(24px, -8px); } }
    @keyframes blink { 0%, 100% { opacity: 0.1; } 50% { opacity: 0.9; } }
  }
</style>
