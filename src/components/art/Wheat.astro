---
// A band of wheat along the ground, swaying if motion is allowed.
---
<div class="field" aria-hidden="true">
  <svg class="wheat" width="100%" height="84" focusable="false">
    <defs>
      <pattern id="wheat-tile" width="54" height="84" patternUnits="userSpaceOnUse">
        <g fill="#5A4830" stroke="#5A4830">
          <path d="M12 84 V 34" stroke-width="2" /><ellipse cx="12" cy="30" rx="3" ry="7" stroke="none" /><ellipse cx="8" cy="22" rx="3" ry="6" stroke="none" /><ellipse cx="16" cy="22" rx="3" ry="6" stroke="none" /><ellipse cx="12" cy="14" rx="3" ry="6" stroke="none" />
          <path d="M30 84 V 42" stroke-width="2" /><ellipse cx="30" cy="38" rx="3" ry="7" stroke="none" /><ellipse cx="26" cy="30" rx="3" ry="6" stroke="none" /><ellipse cx="34" cy="30" rx="3" ry="6" stroke="none" /><ellipse cx="30" cy="22" rx="3" ry="6" stroke="none" />
          <path d="M46 84 V 30" stroke-width="2" /><ellipse cx="46" cy="26" rx="3" ry="7" stroke="none" /><ellipse cx="42" cy="18" rx="3" ry="6" stroke="none" /><ellipse cx="50" cy="18" rx="3" ry="6" stroke="none" /><ellipse cx="46" cy="10" rx="3" ry="6" stroke="none" />
        </g>
      </pattern>
    </defs>
    <rect width="100%" height="84" fill="url(#wheat-tile)" />
  </svg>
  <div class="ground"></div>
</div>

<style>
  .field { position: relative; height: 7rem; overflow: hidden; }
  .wheat { position: absolute; left: 0; right: 0; bottom: 1.2rem; transform-origin: bottom center; }
  .ground { position: absolute; left: 0; right: 0; bottom: 0; height: 1.2rem; background: var(--ground); border-top: 2px solid #3A2F22; }
  @media (prefers-reduced-motion: no-preference) {
    .wheat { animation: sway 7s ease-in-out infinite alternate; }
    @keyframes sway { from { transform: skewX(-2.5deg); } to { transform: skewX(2.5deg); } }
  }
</style>
