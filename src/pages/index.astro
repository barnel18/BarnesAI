---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Pasture from "../components/Pasture.astro";
import Hills from "../components/art/Hills.astro";
import Wheat from "../components/art/Wheat.astro";
import BuildingInPublic from "../components/BuildingInPublic.astro";
import Projects from "../components/Projects.astro";
import Roadmap from "../components/Roadmap.astro";
import Videos from "../components/Videos.astro";
import Signup from "../components/Signup.astro";
import About from "../components/About.astro";
---
<Base>
  <Hero />
  <Pasture
    id="a"
    animals={[
      { kind: "dog", x: "22%", h: "4.2rem", speed: 520 },
      { kind: "rooster", x: "44%", h: "3.2rem", speed: 140 },
      { kind: "cow", x: "60%", h: "5.2rem", speed: 90 },
      { kind: "sheep", x: "84%", h: "3.8rem", speed: 110 },
    ]}
  />
  <BuildingInPublic />
  <Projects />
  <Pasture
    id="b"
    animals={[
      { kind: "pig", x: "10%", h: "4rem", speed: 160 },
      { kind: "sheep", x: "34%", h: "3.8rem", speed: 100 },
      { kind: "rooster", x: "56%", h: "3.2rem", speed: 200 },
      { kind: "dog", x: "78%", h: "4.2rem", speed: 600 },
    ]}
  />
  <Roadmap />
  <Hills />
  <Videos />
  <Wheat />
  <Signup />
  <About />
</Base>
